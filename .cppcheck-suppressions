# PeuBud - supressões cppcheck
# Veja [[TESTES]] T2 + CONTRACT.md §12.1.

# Headers Qt e sistema fora do nosso controle
missingIncludeSystem
unmatchedSuppression

# Falsos positivos comuns com Qt parent-child ownership
# (Qt deleta children, cppcheck não sabe)
noCopyConstructor:*Dialog*
noCopyConstructor:*Widget*

# Macros Qt (Q_OBJECT, Q_PROPERTY) confundem o parser
unknownMacro:Q_OBJECT
unknownMacro:Q_PROPERTY
unknownMacro:Q_INVOKABLE
unknownMacro:Q_SIGNAL
unknownMacro:Q_SLOT

# Structs POD inicializadas por aggregate-init (sem construtor) — idioma do
# projeto (todos os models são POD com `{...}`); cppcheck não entende aggregate-init.
uninitMemberVarNoCtor
uninitMemberVar

# Nota informativa de profundidade de análise (não é achado). O cppcheck do CI
# (fedora:42 = 2.18) IMPRIME esta mensagem `information` em arquivos complexos e,
# com --error-exitcode=2, ela derruba o gate; o cppcheck local mais novo (2.21)
# nem a emite. Suprimir alinha CI×local sem afrouxar o gate para bugs reais.
normalCheckLevelMaxBranches
