# ~/.config/systemd/user/forgejo-runner.service
#
# systemd USER unit (NÃO system/root) — roda como o próprio usuário petrus,
# sem sudo, sem daemon privilegiado. Usa o binário nativo forgejo-runner
# falando com o socket ROOTLESS do podman (unix://$XDG_RUNTIME_DIR/podman/podman.sock)
# pra criar o container fedora:42 de cada job.
#
# Instalação:
#   mkdir -p ~/.config/systemd/user
#   cp forgejo-runner.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now podman.socket
#   systemctl --user enable --now forgejo-runner.service
#
# IMPORTANTE: precisa de `loginctl enable-linger petrus` (já ATIVO nesta
# máquina — confirmado, Linger=yes) pra o serviço sobreviver a logout/sem
# sessão gráfica aberta. Sem linger, o systemd --user mata tudo no logout.

[Unit]
Description=Forgejo Actions Runner (PeuBud self-hosted, rootless podman)
After=network-online.target podman.socket
Wants=network-online.target
Requires=podman.socket

[Service]
Type=simple
WorkingDirectory=%h/.config/forgejo-runner/peubud
Environment=DOCKER_HOST=unix://%t/podman/podman.sock
ExecStart=/usr/local/bin/forgejo-runner daemon --config %h/.config/forgejo-runner/peubud/config.yaml
Restart=on-failure
RestartSec=10

# Hardening (defesa em profundidade — mesmo já sendo user unit sem root,
# o runner executa código do repo dentro do container; isolar o processo
# do runner em si limita o blast radius se algo escapar do container):
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.config/forgejo-runner/peubud %h/.cache/actcache %t/podman

[Install]
WantedBy=default.target
