  <tabstop>kNameInput1</tabstop>
  <tabstop>kNameInput2</tabstop>
  <tabstop>kAdd</tabstop>
  <tabstop>kModifyCategoryButton</tabstop>
  <tabstop>kDeleteUnusedButton</tabstop>
 </tabstops>
 <resources/>
 <connections/>
 <slots>
  <slot>onDoubleClick()</slot>
  <slot>onAddCategory()</slot>
  <slot>onUpdateCategory()</slot>
  <slot>onEditorModified()</slot>
  <slot>cleanEditor()</slot>
  <slot>onDeleteUnused()</slot>
  <slot>onResetInternalFilter()</slot>
 </slots>
