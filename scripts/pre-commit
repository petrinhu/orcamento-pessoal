#!/usr/bin/env bash
# PeuBud - hook pre-commit (#74)
# Instalar: cp scripts/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#
# Bloqueia commits com:
# - warnings novos de clang-tidy nos arquivos C++ alterados
# - erros de cppcheck nos arquivos C++ alterados
# - secrets detectados via gitleaks (se instalado)
# - numerusform VAZIO em peubud_en.ts (#197, I18N-02)

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# ── i18n: numerusform vazio no .ts (#197, I18N-02) ──────────────────────────
# GATE ESTREITO, não o "unfinished" genérico: o app tem ~600 strings
# "unfinished" (traduções pendentes acumuladas, backlog normal/esperado de
# tradução progressiva) -- um gate bloqueando QUALQUER unfinished travaria
# todo commit até um passe de tradução profissional completo (glossário
# financeiro com 92 termos, #197/I18N-04). O bug real e catastrófico é
# numerusform VAZIO: o Qt runtime então mostra STRING EM BRANCO na UI (foi
# exatamente o que sumiu com os contadores do Dashboard em EN, #197/I18N-02)
# -- diferente de "unfinished" comum, que cai no fallback do texto-fonte
# (pt-BR), não em branco. Gate cobre só esse caso específico.
TS_FILE="resources/translations/peubud_en.ts"
if git diff --cached --name-only --diff-filter=ACM | grep -qF "$TS_FILE"; then
  if git show ":$TS_FILE" 2>/dev/null | grep -q '<numerusform></numerusform>'; then
    echo "✗ $TS_FILE tem numerusform VAZIO (plural sem tradução -> string em branco na UI)"
    echo "  Rode lupdate, preencha os numerusform e lrelease antes de commitar."
    exit 1
  fi
fi

# Arquivos C++ staged
mapfile -t CPP_FILES < <(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp)$' || true)

if [ ${#CPP_FILES[@]} -gt 0 ]; then
  echo "▶ pre-commit: ${#CPP_FILES[@]} arquivo(s) C++ staged"

  # cppcheck nos arquivos staged
  # GATE só de BUGS reais: --enable=warning. NÃO incluir 'performance' (nit tipo
  # returnByReference), 'style' nem 'portability' (viram ruído e barram commit bom).
  # --library=qt evita falso-positivo 'unknownMacro: slots/signals'. --language=c++
  # --std=c++20 força parse correto de headers (sem isso, .h vira C → syntaxError).
  if command -v cppcheck >/dev/null 2>&1; then
    echo "  ▸ cppcheck (gate: warning) …"
    cppcheck --enable=warning \
             --library=qt \
             --language=c++ --std=c++20 \
             --inline-suppr \
             --suppressions-list=.cppcheck-suppressions \
             --error-exitcode=2 \
             --quiet \
             "${CPP_FILES[@]}" || { echo "✗ cppcheck encontrou bug real - abortando"; exit 1; }
  else
    echo "  ⚠ cppcheck ausente (dnf install cppcheck / apt install cppcheck / pacman -S cppcheck)"
  fi

  # clang-tidy nos arquivos staged (precisa de build/compile_commands.json)
  # INFORMATIVO, NÃO-FATAL: clang-tidy crasha nesta máquina (Fedora 44 / GCC 16,
  # exit ≥128) e barraria commits legítimos. Rodamos só para feedback visual.
  # TODO: reativar gate (--warnings-as-errors) quando clang-tidy parar de crashar no GCC16 (#143 follow-up).
  if command -v clang-tidy >/dev/null 2>&1 && [ -f build/compile_commands.json ]; then
    echo "  ▸ clang-tidy (informativo, não bloqueia) …"
    clang-tidy -p build "${CPP_FILES[@]}" || echo "  ⚠ clang-tidy reportou avisos ou crashou (não bloqueia - ver TODO #143)"
  elif command -v clang-tidy >/dev/null 2>&1; then
    echo "  ⚠ build/compile_commands.json ausente - rode: cmake -B build -DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
  else
    echo "  ⚠ clang-tidy ausente (dnf install clang-tools-extra / apt install clang-tidy / pacman -S clang)"
  fi
fi

# gitleaks - secrets em qualquer arquivo staged
if command -v gitleaks >/dev/null 2>&1; then
  echo "  ▸ gitleaks …"
  gitleaks protect --staged --no-banner --redact || { echo "✗ secrets detectados - abortando"; exit 1; }
fi

# ctest - sempre rodar testes antes do commit (TDD discipline)
# Detecta primeiro build-dir com tests/ habilitado. Se nenhum, avisa e segue
# (não bloqueia: usuário pode estar trabalhando em ambiente sem cmake configurado).
TEST_BUILD_DIR="$(find . -maxdepth 2 -type d -name 'tests' -path './build*' 2>/dev/null | head -1 | xargs -r dirname)"
if [ -n "${TEST_BUILD_DIR:-}" ] && [ -f "${TEST_BUILD_DIR}/CTestTestfile.cmake" ]; then
  echo "  ▸ ctest (build-dir: ${TEST_BUILD_DIR}) …"
  # Rebuild incremental dos targets de teste (rápido se nada mudou)
  cmake --build "${TEST_BUILD_DIR}" --target all -j"$(nproc)" >/dev/null 2>&1 || true
  # QT_QPA_PLATFORM=offscreen: testes QTEST_MAIN abortam sem display (ambiente
  # headless / pre-commit). offscreen roda Qt sem servidor gráfico.
  QT_QPA_PLATFORM=offscreen \
    ctest --test-dir "${TEST_BUILD_DIR}" --output-on-failure --no-tests=ignore || {
    echo "✗ ctest falhou - corrija os testes antes de commitar"
    exit 1
  }
else
  echo "  ⚠ Nenhum build-dir com BUILD_TESTING habilitado encontrado."
  echo "    Configure com: cmake -B build -DBUILD_TESTING=ON -DCMAKE_BUILD_TYPE=Debug"
  echo "    (commit prosseguindo, mas TDD exige ctest verde)"
fi

echo "✓ pre-commit aprovado"
